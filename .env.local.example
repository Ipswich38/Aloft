# Supabase — create a project at https://supabase.com, then paste values here as .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server-only, NEVER exposed to the client) — used by the status webhook
# to advance flights/orders without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# DJI DeliveryHub handoff (the cloud that actually flies the drone).
# Provider selection:
# - simulated: internal simulator, no DJI credentials needed
# - deliveryhub: REST-style DeliveryHub handoff
# - dji-cloud-api: scaffold for DJI Cloud API credentials/endpoints
FLIGHT_PROVIDER=simulated

# DeliveryHub: Hatid hands cleared flights to this endpoint.
DELIVERYHUB_WEBHOOK_URL=
DELIVERYHUB_API_KEY=
# Shared secret DeliveryHub sends back on the inbound status webhook
# (POST /api/flights/status, header: x-webhook-secret). If unset, dev/sim accepts all.
DELIVERYHUB_WEBHOOK_SECRET=

# DJI Cloud API / Pilot 2 / Dock path. Fill these only after DJI gives the exact
# endpoint and credentials for your organization/app.
DJI_CLOUD_API_ENDPOINT=
DJI_CLOUD_API_TOKEN=
DJI_CLOUD_APP_ID=
DJI_CLOUD_APP_KEY=
DJI_CLOUD_APP_LICENSE=
DJI_CLOUD_WEBHOOK_SECRET=

# Optional simulator webhook shared secret.
SIMULATED_WEBHOOK_SECRET=

# Optional: PayMongo for customer payments (GCash/Maya/cards), matching VissionLink stack
PAYMONGO_SECRET_KEY=
